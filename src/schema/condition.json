{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalWebPage",
      "@id": "{{canonical}}#webpage",
      "url": "{{canonical}}",
      "name": "{{schemaname}}",
      "inLanguage": "cs",
      "medicalAudience": ["Patient", "Parent"],
      "about": { "@id": "{{canonical}}#condition" }
    },
    {
      "@type": "MedicalCondition",
      "@id": "{{canonical}}#condition",
      "name": "{{schemaname}}",
      "inLanguage": "cs"
    }
  ]
}
